<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>今天吃什麼？隨機抽籤機</title>
    <!-- 引入Google字體 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&display=swap" rel="stylesheet">
    <!-- 引入 FontAwesome 圖示庫 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- 引入外部 CSS -->
    <link rel="stylesheet" href="style.css">
    <!-- 引入外部 JS (加上 defer) -->
    <script src="script.js" defer></script>
</head>
<body>
    <div class="background-decorations">
        <span class="floating-icon icon-1">🍕</span>
        <span class="floating-icon icon-2">🍲</span>
        <span class="floating-icon icon-3">🍜</span>
        <span class="floating-icon icon-4">🍱</span>
        <span class="floating-icon icon-5">🍔</span>
    </div>

    <main class="card-container">
        <div class="badge">美食決定器</div>
        
        <!-- 大標題與抽中結果展示區 -->
        <div id="title-container" class="title-box">
            <h1 id="main-title">今天吃什麼？</h1>
        </div>

        <!-- 圖片展示區（初始隱藏） -->
        <div id="food-image-wrapper" class="image-wrapper hidden">
            <img id="food-image" src="" alt="美食圖片" onerror="this.src='https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=600&q=80'">
        </div>

        <!-- 抽籤按鈕與馬上出發按鈕 -->
        <div class="actions">
            <button id="draw-btn" class="btn btn-primary">
                <i class="fa-solid fa-dice"></i> 點我抽籤！
            </button>
            <a id="map-btn" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary hidden">
                <i class="fa-solid fa-location-dot"></i> 馬上出發
            </a>
        </div>
    </main>
</body>
</html>

/* 基礎變數定義 */
:root {
--bg-color: #FFF9E6;
--primary-color: #FF9F1C;
--primary-hover: #FF8800;
--secondary-color: #FFBF00;
--accent-color: #E63946;
--text-color: #4A3E3D;
--card-bg: #FFFFFF;
--shadow-color: rgba(255, 159, 28, 0.25);
}

/* 全域重置與字型 */

{
box-sizing: border-box;
margin: 0;
padding: 0;
font-family: 'Zen Maru Gothic', 'Comic Sans MS', sans-serif;
}

body {
background-color: var(--bg-color);
color: var(--text-color);
display: flex;
justify-content: center;
align-items: center;
min-height: 100vh;
padding: 20px;
position: relative;
overflow-x: hidden;
}

/* 背景漂浮食物裝飾 */
.background-decorations {
position: absolute;
width: 100%;
height: 100%;
top: 0;
left: 0;
pointer-events: none;
z-index: 0;
}

.floating-icon {
position: absolute;
font-size: 2.5rem;
opacity: 0.3;
animation: float 6s ease-in-out infinite alternate;
}

.icon-1 { top: 10%; left: 10%; animation-delay: 0s; }
.icon-2 { top: 70%; left: 12%; animation-delay: 1.5s; }
.icon-3 { top: 15%; right: 12%; animation-delay: 3s; }
.icon-4 { top: 75%; right: 10%; animation-delay: 4.5s; }
.icon-5 { top: 45%; left: 5%; animation-delay: 2s; }

@keyframes float {
0% { transform: translateY(0) rotate(0deg); }
100% { transform: translateY(-20px) rotate(15deg); }
}

/* 主卡片容器 */
.card-container {
background: var(--card-bg);
width: 100%;
max-width: 480px;
padding: 40px 30px;
border-radius: 32px;
box-shadow: 0 20px 40px var(--shadow-color), 0 0 0 8px #FFF0C2;
text-align: center;
position: relative;
z-index: 1;
transition: all 0.3s ease;
}

/* 小徽章 */
.badge {
display: inline-block;
background-color: #FFE599;
color: #D97706;
font-weight: 700;
padding: 6px 16px;
border-radius: 20px;
font-size: 0.9rem;
margin-bottom: 20px;
}

/* 標題區塊 */
.title-box {
min-height: 90px;
display: flex;
align-items: center;
justify-content: center;
margin-bottom: 25px;
}

#main-title {
font-size: 2rem;
font-weight: 900;
color: var(--primary-color);
text-shadow: 2px 2px 0px #FFE5B4;
word-break: break-word;
transition: transform 0.2s ease;
}

/* 生動彈跳動畫效果 */
.bounce-animation {
animation: bounce 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes bounce {
0% { transform: scale(0.3); opacity: 0; }
50% { transform: scale(1.1); }
70% { transform: scale(0.9); }
100% { transform: scale(1); opacity: 1; }
}

/* 圖片容器與樣式 */
.image-wrapper {
width: 100%;
height: 240px;
border-radius: 24px;
overflow: hidden;
margin-bottom: 25px;
box-shadow: 0 8px 16px rgba(0,0,0,0.1);
border: 4px solid var(--secondary-color);
}

.image-wrapper img {
width: 100%;
height: 100%;
object-fit: cover;
transition: transform 0.5s ease;
}

.image-wrapper:hover img {
transform: scale(1.05);
}

/* 按鈕樣式 */
.actions {
display: flex;
flex-direction: column;
gap: 15px;
}

.btn {
display: inline-flex;
align-items: center;
justify-content: center;
gap: 8px;
width: 100%;
padding: 16px 24px;
font-size: 1.25rem;
font-weight: 700;
border: none;
border-radius: 50px;
cursor: pointer;
text-decoration: none;
transition: all 0.2s ease;
}

.btn-primary {
background-color: var(--primary-color);
color: white;
box-shadow: 0 6px 0px #D97706;
}

.btn-primary:hover {
background-color: var(--primary-hover);
transform: translateY(-2px);
box-shadow: 0 8px 0px #D97706;
}

.btn-primary:active {
transform: translateY(4px);
box-shadow: 0 2px 0px #D97706;
}

.btn-secondary {
background-color: #10B981;
color: white;
box-shadow: 0 6px 0px #047857;
}

.btn-secondary:hover {
background-color: #059669;
transform: translateY(-2px);
box-shadow: 0 8px 0px #047857;
}

.btn-secondary:active {
transform: translateY(4px);
box-shadow: 0 2px 0px #047857;
}

/* 隱藏元素用 */
.hidden {
display: none !important;
}

// 確保 HTML DOM 結構載入完成後才執行程式碼
document.addEventListener('DOMContentLoaded', () => {
    
    // 餐廳資料庫
    const foodList = [
        {
            name: "六扇門時尚湯鍋-高雄興楠店",
            image: "https://images.unsplash.com/photo-1547592180-85f173990554?auto=format&fit=crop&w=600&q=80", // 火鍋照片
            mapUrl: "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent("六扇門時尚湯鍋-高雄興楠店")
        },
        {
            name: "一碗螺 螺螄粉",
            image: "https://images.unsplash.com/photo-1569718212165-3a8278d5f624?auto=format&fit=crop&w=600&q=80", // 麵食/螺螄粉照片
            mapUrl: "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent("一碗螺 螺螄粉")
        },
        {
            name: "DoNi製丼所",
            image: "https://images.unsplash.com/photo-1553621042-f6e147245754?auto=format&fit=crop&w=600&q=80", // 日式丼飯照片
            mapUrl: "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent("DoNi製丼所")
        },
        {
            name: "咘咘廚房 異國料理 (大社店)",
            image: "https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=600&q=80", // 異國料理照片
            mapUrl: "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent("咘咘廚房 異國料理 大社店")
        },
        {
            name: "卡布 義式料理",
            image: "https://images.unsplash.com/photo-1551183053-bf91a1d81141?auto=format&fit=crop&w=600&q=80", // 義大利麵/料理照片
            mapUrl: "https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent("卡布 義式料理")
        }
    ];

    // 取得 DOM 元素
    const mainTitle = document.getElementById('main-title');
    const drawBtn = document.getElementById('draw-btn');
    const mapBtn = document.getElementById('map-btn');
    const foodImageWrapper = document.getElementById('food-image-wrapper');
    const foodImage = document.getElementById('food-image');

    let isSpinning = false; // 防連點開關

    // 點擊抽籤按鈕事件
    drawBtn.addEventListener('click', () => {
        if (isSpinning) return;
        isSpinning = true;

        // 改變按鈕狀態
        drawBtn.innerText = "抽取中...";
        drawBtn.disabled = true;

        // 隨機滾動動畫效果
        let counter = 0;
        const speed = 100; // 每 100ms 換一次文字
        const totalTimes = 15; // 滾動 15 次後停止

        const timer = setInterval(() => {
            const randomIndex = Math.floor(Math.random() * foodList.length);
            mainTitle.innerText = foodList[randomIndex].name;
            counter++;

            if (counter >= totalTimes) {
                clearInterval(timer);
                
                // 決定最終結果
                const finalResult = foodList[Math.floor(Math.random() * foodList.length)];
                
                // 更新畫面標題與動畫
                mainTitle.innerText = ` 🎉 今天就吃：\n${finalResult.name}`;
                mainTitle.classList.remove('bounce-animation');
                void mainTitle.offsetWidth; // 觸發 CSS 重繪以重置動畫
                mainTitle.classList.add('bounce-animation');

                // 更新美食圖片
                foodImage.src = finalResult.image;
                foodImageWrapper.classList.remove('hidden');
                foodImageWrapper.classList.remove('bounce-animation');
                void foodImageWrapper.offsetWidth;
                foodImageWrapper.classList.add('bounce-animation');

                // 更新 Google Map 連結並顯示按鈕
                mapBtn.href = finalResult.mapUrl;
                mapBtn.classList.remove('hidden');
                mapBtn.classList.add('bounce-animation');

                // 恢復抽籤按鈕
                drawBtn.innerHTML = '<i class="fa-solid fa-dice"></i> 再抽一次！';
                drawBtn.disabled = false;
                isSpinning = false;
            }
        }, speed);
    });
});
